# 第八章环境配置示例
# 复制此文件到 .env 并根据实际情况填写

# ================================
# 大模型配置 (Kimi/OpenAI兼容)
# ================================
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_ID=

# ================================
# Tavily 搜索 API (可选)
# ================================
TAVILY_API_KEY=

# ================================
# Qdrant 向量数据库配置
# 获取API密钥: https://cloud.qdrant.io/
# ================================
# 使用 Qdrant 云服务
# QDRANT_URL=https://your-cluster.qdrant.tech:6333
QDRANT_URL=
QDRANT_API_KEY=

# 或使用本地 Qdrant (需要Docker)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Qdrant 集合配置
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ================================
# Neo4j 图数据库配置
# 获取API密钥: https://neo4j.com/cloud/aura/
# ================================
# 使用 Neo4j Aura 云服务
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=

# 或使用本地 Neo4j (需要Docker)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=hello-agents-password

# Neo4j 连接配置
NEO4J_DATABASE=your id
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ==========================
# 嵌入（Embedding）配置
# 可从阿里云控制台获取: https://dashscope.aliyun.com/
# ==========================
# 若为空，dashscope 默认 text-embedding-v3
# local 默认 sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=
EMBED_API_KEY=
EMBED_BASE_URL=

# ==========================
# 本地存储路径
# ==========================
MEMORY_DB_PATH=./memory_data/memory.db
KNOWLEDGE_BASE_PATH=./knowledge_base
